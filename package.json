{
  "name": "@entrolytics/svelte-sdk",
  "version": "3.0.1",
  "description": "SvelteKit integration for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "entrolytics",
    "svelte",
    "sveltekit",
    "tracking",
    "web-analytics"
  ],
  "homepage": "https://entrolytics.dev",
  "bugs": {
    "url": "https://github.com/entrolytics/svelte-sdk/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/svelte-sdk",
    "directory": "entro-svelte"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --noEmit false",
    "check": "tsc --noEmit",
    "dev": "tsdown --watch",
    "format": "oxfmt --write .",
    "lint": "oxlint --fix . && oxfmt --write .",
    "lint:check": "oxlint . && oxfmt --check .",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --type-aware --type-check --fix --fix-suggestions --fix-dangerously src/",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@entrolytics/shared": "^3.1.0"
  },
  "devDependencies": {
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "svelte": "^5.57.3",
    "tsdown": "^0.23.5",
    "typescript": "next"
  },
  "peerDependencies": {
    "svelte": ">=5.51.2"
  },
  "optionalDependencies": {
    "web-vitals": "^6.2.3"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "packageManager": "pnpm@12.17.0"
}
